# Set these in Vercel > Settings > Environment Variables. Never use VITE_ for secrets.
FRAME_PASSWORD=replace-with-a-random-password-at-least-16-characters
FRAME_SECRET=replace-with-a-random-secret-at-least-32-characters
# Connect Upstash Redis through Vercel Marketplace; KV_REST_API_* names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Create a PRIVATE Vercel Blob store and connect it to this project.
BLOB_READ_WRITE_TOKEN=
# Optional: alternatively save the key in the authenticated app settings.
DEEPKEY_API_KEY=
DEEPKEY_BASE_URL=https://deepkey.top
# Use separate storage and namespace for preview deployments.
FRAME_NAMESPACE=frame:production:v1
