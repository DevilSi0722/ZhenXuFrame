# Required. Set in Vercel > Settings > Environment Variables, then redeploy.
# Never prefix secrets with VITE_ or commit real values to GitHub.
FRAME_PASSWORD=replace-with-a-random-password-at-least-16-characters
DEEPKEY_API_KEY=
# Optional HTTPS API root. Defaults to https://deepkey.top
DEEPKEY_BASE_URL=https://deepkey.top
# Optional separate session signing secret, at least 32 characters.
# FRAME_SECRET=
# No Redis, Blob, or other database credentials are required.
